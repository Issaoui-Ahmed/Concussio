# Copy to .env and fill in the secrets. Non-secret values below are the ones actually in use --
# they match the code's own defaults, spelled out so this file is the single place to read what a
# run is configured with.

# --- Fuel IX ----------------------------------------------------------------------------------

FUELIX_API_KEY=your_fuelix_api_key_here
FUELIX_API_BASE_URL=https://api.fuelix.ai/v1
FUELIX_PRODUCT_ID=core

# How long a copilot run may poll before giving up. Runs that hit the tool corpus are slow;
# below ~180s they get cut off mid-answer.
FUELIX_RUN_TIMEOUT_SECONDS=240

# OpenAI-branded model ids, served through Fuel IX's OpenAI-compatible API.
FUELIX_TRANSLATE_MODEL=gpt-5.2
FUELIX_FOLLOWUP_MODEL=gpt-4.1-mini

# Fuel IX assistant ids, one per user type. Without these, resolve_assistant_id() falls back
# to GET /assistants on every request, adding a network round-trip to each message.
# (A single FUELIX_ASSISTANT_ID also works as a catch-all for every role, but naming the six is
# what production does.)
FUELIX_ASSISTANT_ID_PATIENT=
FUELIX_ASSISTANT_ID_HEALTHCARE_PROFESSIONAL=
FUELIX_ASSISTANT_ID_PARENT_OR_CAREGIVER=
FUELIX_ASSISTANT_ID_YOUTH=
FUELIX_ASSISTANT_ID_TEACHER=
FUELIX_ASSISTANT_ID_COACH=

# Deliberately not set: the tools vector store is resolved by name, so a store rebuilt under the
# same name is still found. Pin it only to point a run at a copy.
# FUELIX_TOOLS_VECTOR_STORE_ID=

# --- Supabase ---------------------------------------------------------------------------------
#
# Pairing table and pipeline run history, read and written over PostgREST. The same two values
# are needed as GitHub repo secrets for the content-verify workflow's gates step.

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# --- Demo password ------------------------------------------------------------------------------
#
# The single password in front of the whole prototype: the Next.js layouts render the gate instead
# of the app until a visitor types it, and api/main.py rejects /api/chat, /api/followups and
# /api/translate without the cookie it hands out. Both halves derive that cookie from this value,
# so there is nothing else to keep in sync -- but it must also exist in the Vercel project env, or
# the deployment locks itself and says so on screen.
#
# Not the real password: this file is committed. The value in use lives in .env and in Vercel.
DEMO_PASSWORD=your_demo_password_here

# --- Admin password -----------------------------------------------------------------------------
#
# The second gate, in front of /admin only and asked for after the demo password. Every invited
# tester holds the demo password, while the admin pages rerun the content pipeline, rewrite the
# pairings and delete Fuel IX vector stores, so the tooling gets a password of its own
# (`lib/adminAccess.ts`). Page-level only: it decides who is shown /admin, not who may call the
# endpoints those pages use.
#
# Also needed in the Vercel project env, or the deployed /admin locks itself and says so on screen.
#
# Not the real password: this file is committed. The value in use lives in .env and in Vercel.
ADMIN_PASSWORD=your_admin_password_here

# --- Cron --------------------------------------------------------------------------------------
#
# Gates /api/cron/refresh. This same value must also exist in the Vercel project env: Vercel
# sends it as `Authorization: Bearer $CRON_SECRET`, and the handler compares against its own
# environment. Set here but not in Vercel, the nightly refresh answers 500 and never runs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=your_cron_secret_here

# --- CHEO SharePoint research log ---------------------------------------------------------------
#
# Where chat exchanges are recorded for the CHEO REB study: one JSON file per exchange, holding
# only the fields the approved protocol lists (core/research_log.py). The app signs in to
# Microsoft Graph as itself with a certificate -- no user, no client secret -- and reaches only
# what CHEO granted it: Sites.Selected, with write on the one site that holds the folder.
# /admin/research-log shows what a deployment is configured with and tests the whole path.
#
# The real values are CHEO's and stay out of this file, which is committed. They live in .env
# and in the Vercel project env.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
# The site's address: https://<tenant>.sharepoint.com/sites/<site>
SHAREPOINT_SITE_URL=
# The library, then the folder inside it, as they read in the folder's address after the site:
#     https://<tenant>.sharepoint.com/sites/<site>/Files/My%20Folder  ->  Files/My Folder
SHAREPOINT_FOLDER_PATH=

# The private half of the certificate whose public half is uploaded to the app registration.
# Base64 of the PEM, on one line: the raw PEM's newlines survive neither the Vercel env UI nor a
# copy-paste between shells.
# Not the real key: this file is committed. The value in use lives in .env and in Vercel.
SHAREPOINT_CERT_PRIVATE_KEY_B64=

# The certificate's SHA-1 thumbprint, as Entra shows it next to the uploaded certificate (colons
# optional). It is how Entra picks which of the app's certificates checks the signature.
SHAREPOINT_CERT_THUMBPRINT=

# Chat logging is switched on separately from being configured, so that a machine holding the
# certificate -- a developer's, a preview deployment -- doesn't send its own test chats into the
# study folder. Set to true in the production environment when the study starts, and nowhere
# else. The admin connection test works either way; a failed write never costs a participant
# their answer.
SHAREPOINT_LOG_CHATS=
