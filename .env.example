# Copy to .env and fill in the secrets. Non-secret values below are the ones actually in use --
# they match the code's own defaults, spelled out so this file is the single place to read what a
# run is configured with.

# --- Fuel IX ----------------------------------------------------------------------------------

FUELIX_API_KEY=your_fuelix_api_key_here
FUELIX_API_BASE_URL=https://api.fuelix.ai/v1
FUELIX_PRODUCT_ID=core

# How long a copilot run may poll before giving up. Runs that hit the tool corpus are slow;
# below ~180s they get cut off mid-answer.
FUELIX_RUN_TIMEOUT_SECONDS=240

# OpenAI-branded model ids, served through Fuel IX's OpenAI-compatible API.
FUELIX_TRANSLATE_MODEL=gpt-5.2
FUELIX_FOLLOWUP_MODEL=gpt-4.1-mini

# Fuel IX assistant ids, one per user type. Without these, resolve_assistant_id() falls back
# to GET /assistants on every request, adding a network round-trip to each message.
# (A single FUELIX_ASSISTANT_ID also works as a catch-all for every role, but naming the six is
# what production does.)
FUELIX_ASSISTANT_ID_PATIENT=
FUELIX_ASSISTANT_ID_HEALTHCARE_PROFESSIONAL=
FUELIX_ASSISTANT_ID_PARENT_OR_CAREGIVER=
FUELIX_ASSISTANT_ID_YOUTH=
FUELIX_ASSISTANT_ID_TEACHER=
FUELIX_ASSISTANT_ID_COACH=

# Deliberately not set: the tools vector store is resolved by name, so a store rebuilt under the
# same name is still found. Pin it only to point a run at a copy.
# FUELIX_TOOLS_VECTOR_STORE_ID=

# --- Supabase ---------------------------------------------------------------------------------
#
# Pairing table and pipeline run history, read and written over PostgREST. The same two values
# are needed as GitHub repo secrets for the content-verify workflow's gates step.

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# --- Cron --------------------------------------------------------------------------------------
#
# Gates /api/cron/refresh. This same value must also exist in the Vercel project env: Vercel
# sends it as `Authorization: Bearer $CRON_SECRET`, and the handler compares against its own
# environment. Set here but not in Vercel, the nightly refresh answers 500 and never runs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=your_cron_secret_here
