# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate build dirs via NEXT_DIST_DIR (see next.config.ts) — used to run a second dev
# server alongside one that already holds the .next/dev lock.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python cache artifacts
__pycache__/
*.py[cod]
# Run reports from the (deleted) OpenAI -> Fuel IX vector store migration. Kept ignored so the
# leftover local artifacts never get committed.
api/openai_to_fuelix_vector_store_migration_*.json
api/fuelix_assistant_rebuild_*.json

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
